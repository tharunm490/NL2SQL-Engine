# ==========================================
# Application Information
# ==========================================
APP_NAME=AI SQL Assistant
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI SQL Assistant for PostgreSQL
DEBUG=false

# ==========================================
# Application PostgreSQL Database
# Connection string for the application database.
# Can be any PostgreSQL 14+ provider: Supabase, Neon, AWS RDS, Azure, etc.
# The async driver prefix (+asyncpg) is required for DATABASE_URL.
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_sql_assistant
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/ai_sql_assistant

# Example Supabase pooler connection:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL_SYNC=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ==========================================
# JWT Authentication
# ==========================================
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# CORS
# Update with your frontend domain in production
# ==========================================
CORS_ORIGINS=["http://localhost:80","http://localhost"]

# ==========================================
# Encryption Key
# Used to encrypt customer database passwords at rest
# ==========================================
DB_ENCRYPTION_KEY=change-this-to-a-32-byte-random-key

# ==========================================
# LLM Configuration
# ==========================================
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-codex-mini

# ==========================================
# Registration Configuration
# Set to false to disable analyst self-registration.
# ==========================================
ALLOW_ANALYST_SELF_REGISTRATION=true

# ==========================================
# Redis Configuration
# When running with Docker Compose, REDIS_HOST must be "redis" (service name).
# For local development, use "localhost".
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SCHEMA=3600
REDIS_TTL_STATUS=60
