APP_NAME=AI SQL Assistant
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI SQL Assistant for PostgreSQL
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_sql_assistant
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_sql_assistant

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
LOG_FORMAT=json

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DB_ENCRYPTION_KEY=your-encryption-key-change-in-production

# LLM Configuration (supports OpenAI-compatible APIs: OpenAI, Groq, Azure, Ollama, etc.)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
