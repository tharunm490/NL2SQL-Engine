APP_NAME=AI SQL Assistant
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI SQL Assistant for PostgreSQL
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_sql_assistant
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_sql_assistant

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
LOG_FORMAT=json

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DB_ENCRYPTION_KEY=your-encryption-key-change-in-production

# LLM Configuration
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-codex-mini

# ======================================
# Redis Configuration
# ======================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SCHEMA=3600
REDIS_TTL_STATUS=60
